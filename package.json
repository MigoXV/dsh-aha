{
  "name": "dsh-aha",
  "version": "0.1.0",
  "description": "基于官方 DeepSeek Harness 发布包的独立 Web 启动壳",
  "private": true,
  "type": "module",
  "bin": {
    "dsh-aha": "./lib/bin.js"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter @dsh-aha/ui-champagne build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "pnpm --filter @dsh-aha/ui-champagne build && tsx src/bin.ts",
    "lint": "oxlint src tests packages/ui-champagne/src packages/ui-champagne/client.js",
    "start": "node lib/bin.js",
    "test": "pnpm --filter @dsh-aha/ui-champagne build && vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @dsh-aha/ui-champagne typecheck"
  },
  "dependencies": {
    "@dsh-aha/ui-champagne": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.1-rc.2",
    "@deepseek-ai/dsh-base": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web-app": "0.1.1-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
